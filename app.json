{
  "expo": {
    "name": "653 Gym & Fitness",
    "slug": "653-gym-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo653.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "splash": {
      "image": "./assets/logo653.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gym653.app"
    },
    "android": {
      "package": "com.gym653.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/logo653.png"
      }
    },
    "web": {
      "favicon": "./assets/logo653.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/logo653.png",
          "color": "#e3202f"
        }
      ]
    ]
  }
}
